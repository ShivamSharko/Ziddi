{
  "name": "ziddi",
  "version": "0.1.0",
  "private": true,
  "description": "Ziddi — the AI agent that never gives up on your grievance.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter @ziddi/web test:e2e",
    "test:e2e:ui": "pnpm --filter @ziddi/web test:e2e:ui",
    "clean": "turbo run clean && rm -rf node_modules",
    "evals": "tsx evals/run-evals.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "tsx": "^4.19.0",
    "turbo": "^2.5.4",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@google/genai",
      "better-sqlite3",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
