{
  "manifest_version": 3,
  "name": "Ziddi Portal Automation",
  "version": "1.0.0",
  "description": "Auto-fill Indian government grievance portals from Ziddi cases",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://pgportal.gov.in/*",
    "https://edaakhil.nic.in/*",
    "https://rtionline.gov.in/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://pgportal.gov.in/*"],
      "js": ["content-cpgrams.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://edaakhil.nic.in/*"],
      "js": ["content-edaakhil.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://rtionline.gov.in/*"],
      "js": ["content-rti.js"],
      "run_at": "document_idle"
    }
  ]
}
